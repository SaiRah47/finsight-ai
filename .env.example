# Add to Vercel > Project Settings > Environment Variables, then redeploy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only UUID from Authentication > Users. Do not prefix NEXT_PUBLIC_.
FINSIGHT_OWNER_USER_ID=

# Market data: server-side Twelve Data API key, never use NEXT_PUBLIC_.
TWELVE_DATA_API_KEY=

# Required for SEC EDGAR; must include an application name and real contact email.
# Example: FinSightAtlas research-contact@example.com (replace with your OWN monitored email).
SEC_USER_AGENT=

# Optional paid LLM synthesis. Leave blank for free deterministic evidence summaries.
FINSIGHT_OPENAI_API_KEY=
FINSIGHT_LLM_MODEL=gpt-6-luna
